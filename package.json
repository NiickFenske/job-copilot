{
  "name": "job-copilot",
  "version": "0.1.0",
  "description": "Personal job search copilot: fetch -> filter -> score -> tailor -> review. No auto-apply.",
  "type": "module",
  "scripts": {
    "fetch": "tsx src/cli/fetch.ts",
    "discover": "tsx src/cli/discover.ts",
    "add-job": "tsx src/cli/add-job.ts",
    "reset-scores": "tsx src/cli/reset-scores.ts",
    "score": "tsx src/cli/score.ts",
    "tailor": "tsx src/cli/tailor.ts",
    "dashboard": "npm --prefix dashboard run dev"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "dotenv": "^16.4.5",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4"
  }
