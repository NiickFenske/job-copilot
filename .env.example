# --- AI backend -------------------------------------------------------------
# By default the scoring/tailoring steps run Claude Code in headless mode
# ("claude -p") and use the Claude subscription you're signed in with:
#     claude auth login
# No API key is needed for that. Check your setup with:  npm run ai-check
#
# To use the Anthropic API instead (billed per token to your API account):
# AI_BACKEND=api
# ANTHROPIC_API_KEY=
#
# Safe to leave ANTHROPIC_API_KEY set while on the default backend: it is
# removed from the environment of every "claude" process this project starts,
# so it can't silently redirect headless calls to API billing.

# --- Optional tuning (defaults shown) ---------------------------------------
# SCORE_LIMIT=            # max jobs to process per "npm run score" run (protects your subscription allowance)
# AI_CONCURRENCY=2        # how many Claude calls run at once
# AI_MODEL_SCREEN=claude-haiku-4-5-20251001
# AI_MODEL_SCORE=claude-sonnet-5
# AI_MODEL_TAILOR=claude-sonnet-5
# AI_TIMEOUT_MS=180000    # per-call timeout
# CLAUDE_BIN=             # full path to the claude command if it isn't on your PATH

# --- Optional job-source keys (the fetchers skip themselves if blank) -------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
